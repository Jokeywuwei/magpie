+
+/* ---------- small screens: usage, request log and touch (P0) ---------- */
+/* The request log's six fixed columns need 714px of card, which a tablet
+   under 900px does not have; one request becomes a short block, each field
+   named by the data-label usage.js already writes (addCell), so no markup
+   or script changes. */
+@media (max-width: 900px) {
+  .logs-head { flex-direction: column; align-items: stretch; gap: 10px; }
+  .log-row { display: block; padding: 12px 0; }
+  .log-row.head { display: none; }
+  .log-row > * { display: block; }
+  .log-row > * + * { margin-top: 4px; }
+  .log-row > [data-label]:not(.log-status)::before {
+    content: attr(data-label) "：";
+    margin-right: 6px;
+    color: var(--muted);
+    font-size: 11.5px;
+    font-weight: 600;
+  }
+  .log-model { overflow-wrap: anywhere; }
+  .log-model b { display: inline; white-space: normal; overflow-wrap: anywhere; }
+  .log-model span { display: inline; margin-left: 6px; }
+  .log-status { display: inline-flex; width: fit-content; margin-top: 8px; }
+  /* a long token count wraps instead of widening the card */
+  .log-tokens { white-space: normal; overflow-wrap: anywhere; }
+  .log-ms { text-align: left; }
+}
+
+/* The stat grid is six fixed columns, which at 390px leaves 44px a tile and
+   breaks 「输入 Token」 one character a line. Two columns, as magpie's own
+   .stats does (app.css:4886). A coarse pointer counts as small too: magpie's
+   page uses the same pair (app.css:389). */
+@media (max-width: 760px), (pointer: coarse) and (max-width: 1024px) {
+  .usage-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+
+  /* The card head keeps the range chips beside the copy until the copy takes
+   the width they need; stacked, the chips get the full row instead of the
+   118px column that folded them into three lines. */
+  .usage-head { flex-direction: column; align-items: stretch; gap: 10px; }
+  .usage-head .segs { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 2px; }
+  .usage-head .segs .chip { flex: none; }
+  .log-err { margin-top: 6px; }
+
+  /* 16px keeps iOS from zooming the page when a field takes focus; 44px is
+   a finger, the same sizes magpie's own web page uses (app.css:4901-4903). */
+  input:not([type="range"]):not([type="checkbox"]):not([type="radio"]),
+  textarea, select { font-size: 16px; min-height: 44px; }
+
+  /* the rest of the targets a thumb has to hit (a small button included) */
+  .btn, .btn.sm, .chip { min-height: 44px; }
+  .log-filters select, #logRefresh, #logPrev, #logNext, .toolbar-select { min-height: 44px; }
+  /* the header's and the footer's links are navigation, not running text */
+  .brand, .nav a, .account .who, .footer a { display: inline-flex; align-items: center; min-height: 44px; }
+
+  /* a switch keeps its 38x22 look, with a 44px target around it */
+  .am-toggle { position: relative; }
+  .am-toggle::before { content: ""; position: absolute; inset: -11px -3px; }
+}
